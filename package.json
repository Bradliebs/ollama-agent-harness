{
  "name": "ollama-agent-harness",
  "version": "0.1.10",
  "description": "A local-first agentic system wrapping Ollama's API, borrowing architectural patterns from the Claude Code paper",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "harness": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "ui": "ts-node src/web/server.ts",
    "serve": "node dist/web/server.js",
    "smoke:ui": "node scripts/ui-smoke.js",
    "smoke:release": "node scripts/release-smoke.js",
    "release:notes": "node scripts/release-notes.js",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ollama",
    "agent",
    "harness",
    "ai",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "ollama": "^0.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "playwright": "^1.57.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  }
}
