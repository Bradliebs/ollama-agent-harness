{
  "name": "ollama-agent-harness",
  "version": "0.6.5",
  "private": true,
  "description": "A local-first agentic system wrapping Ollama's API, borrowing architectural patterns from the Claude Code paper",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "harness": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "ui/",
    "start.bat",
    "start.sh",
    "START-HERE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "help": "node scripts/help.js",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "ui": "ts-node src/web/server.ts",
    "serve": "node dist/web/server.js",
    "smoke:transport": "node scripts/transport-smoke.js",
    "smoke:mycelium": "node scripts/mycelium-smoke.js",
    "smoke:long-prompt": "node scripts/live-long-prompt-smoke.js",
    "smoke:headless": "node scripts/headless-smoke.js",
    "smoke:dependency-audit": "node scripts/dependency-audit-grant-smoke.js",
    "smoke:telegram": "node scripts/telegram-smoke.js",
    "smoke:ui": "node scripts/ui-smoke.js",
    "smoke:ui:fresh": "node scripts/ui-smoke.js --fresh",
    "smoke:beginner": "node scripts/beginner-smoke.js",
    "smoke:retry-fault": "node scripts/retry-fault-probe.js",
    "smoke:release": "node scripts/release-smoke.js",
    "smoke:installer": "node scripts/installer-smoke.js",
    "smoke:bounded-news": "node scripts/bounded-news-smoke.js",
    "smoke:remote-backends": "node scripts/remote-backend-smoke.js",
    "smoke:voice": "node scripts/jarvis-voice-smoke.js",
    "smoke:voice:bargein": "node scripts/jarvis-bargein-smoke.js",
    "diagnose:mistral": "node scripts/mistral-roundtrip.js",
    "diagnose:gemma-tool": "node scripts/lean-gemma-tool-probe.js",
    "validate:routing": "node scripts/validate-routing.js",
    "debug:payloads": "node scripts/debug-payload-summary.js",
    "release:provenance": "node scripts/generate-release-provenance.js --write",
    "release:dry-run": "node scripts/release-dry-run.js",
    "release:bump": "node scripts/bump-version.js",
    "release:ready": "node scripts/check-release-ready.js",
    "verify:versions": "node scripts/verify-release-versions.js",
    "verify:changelog": "node scripts/check-changelog-version.js",
    "release:notes": "node scripts/release-notes.js",
    "release:manifest": "node scripts/release-manifest.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "validate:autonomy": "tsc --noEmit && jest --silent --passWithNoTests",
    "audit:triage": "node scripts/audit-triage.js",
    "audit:automation-jobs": "node scripts/audit-automation-jobs.js",
    "cleanup:automation-jobs": "node scripts/cleanup-automation-jobs.js",
    "autonomy": "ts-node cookbook/task-loop.ts",
    "autonomy:dry": "ts-node cookbook/task-loop.ts --dry-run",
    "autonomy:debug": "node -e \"process.env.HARNESS_DEBUG_LOG='.forge-debug.jsonl';require('child_process').spawnSync(process.execPath,[require.resolve('ts-node/dist/bin'),'cookbook/task-loop.ts'],{stdio:'inherit',env:process.env})\"",
    "autonomy:stop": "node -e \"require('fs').writeFileSync('.forge-stop','stop')\"",
    "autonomy:reset": "node -e \"['.forge-stop','.forge-state.json'].forEach(f=>{try{require('fs').unlinkSync(f)}catch{}})\"",
    "experiment:run": "ts-node src/experiments/cli.ts",
    "jarvis:mcp": "node scripts/jarvis-mcp-serve.js",
    "jarvis:seed": "node scripts/jarvis-seed-kg.js",
    "jarvis:compact": "node scripts/jarvis-compact-kg.js",
    "jarvis:export-ladder": "node scripts/jarvis-export-ladder.js",
    "jarvis:import-ladder": "node scripts/jarvis-import-ladder.js",
    "jarvis:brief-telegram": "node scripts/jarvis-brief-telegram.js",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/marked/lib/marked.umd.js','ui/marked.min.js')\""
  },
  "keywords": [
    "ollama",
    "agent",
    "harness",
    "ai",
    "local-first"
  ],
  "license": "MIT",
  "dependencies": {
    "@types/ws": "^8.18.1",
    "discord.js": "^14.26.4",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "imapflow": "^1.3.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "18.0.3",
    "nodemailer": "^8.0.7",
    "ollama": "^0.5.0",
    "pdfjs-dist": "^5.7.284",
    "pdfkit": "^0.18.0",
    "ws": "^8.20.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "jest": "^29.0.0",
    "playwright": "^1.57.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bradliebs/ollama-agent-harness.git"
  },
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Bradliebs/ollama-agent-harness/issues"
  },
  "homepage": "https://github.com/Bradliebs/ollama-agent-harness#readme"
}
