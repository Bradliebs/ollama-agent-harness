# All hand-written scripts in scripts/ are real source. Without this
# blanket un-ignore, new scripts/*.js files get silently dropped from
# `git status` (see scripts/headless-smoke.js, scripts/autonomy-docker.js
# which both fell into this trap before the rule was added).
!scripts/*.js
!ui/app.js
!ui/chatHistory.js
.env
.env.local
.harness/
.copilot-tracking/
Network.md

# Bare-filename agent writes (file_write redirects scratch output here so
# it does not pile up at the repo root). Force-add intentional outputs.
agent-outputs/

